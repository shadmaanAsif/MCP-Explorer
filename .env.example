# Copy to .env (git-ignored) and edit. Every value below is the built-in
# default, so the project also runs with no .env at all. A variable already
# set in your shell wins over this file.
#
# Loaded by: pnpm start:http, pnpm issuer, pnpm client, pnpm web, pnpm web:dev.
# Not loaded by the stdio server (pnpm start): an MCP client such as Cursor
# starts that one and passes its own env in mcp.json.

# ---- Ports: one line per process ----------------------------------------
MCP_SERVER_PORT=4768     # MCP server (pnpm start:http), path /mcp
WEB_PORT=4767            # web dashboard (pnpm web, pnpm web:dev)
ISSUER_PORT=4769         # token issuer (pnpm issuer serve)

# ---- Where things find each other ---------------------------------------
# Used by the CLI client and the dashboard. Change it with MCP_SERVER_PORT.
MCP_SERVER_URL=http://localhost:4768/mcp
# The issuer's public address; goes into every token as `iss`.
ISSUER_URL=http://localhost:4769

# ---- Token issuer (Stage 9) ---------------------------------------------
ISSUER_KEY_FILE=.auth/issuer-key.json   # relative to packages/server; git-ignored
TOKEN_AUDIENCE=http://localhost:4768/mcp  # `aud` of new tokens = the MCP server URL
TOKEN_TTL_SECONDS=3600                  # lifetime of a new token

# ---- MCP server behaviour -----------------------------------------------
MCP_MODE=stateful                # or: stateless
MCP_SESSION_TTL_MS=1800000       # idle sessions are dropped after this long

# ---- Code review tools (Stage 8); all optional --------------------------
# REVIEW_ROOT=/absolute/path/to/project
# REVIEW_ALLOWED_ROOTS=/path/a:/path/b
# REVIEW_ALLOW_HTTP=1
# REVIEW_REQUIRE_ROOT=1
# REVIEW_CHECK_TIMEOUT_MS=120000

# ---- Weather tool; all optional -----------------------------------------
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_FETCH_TIMEOUT_MS=8000
# WEATHER_RETRY_BASE_DELAY_MS=300
