# Copy to packages/web/.env (git-ignored). A shell variable wins.
# Next.js loads this file itself; WEB_PORT is read by scripts/next.mjs.

# Dashboard port
WEB_PORT=4767

# MCP server the dashboard talks to (server side only, not sent to the browser)
MCP_SERVER_URL=http://localhost:4768/mcp

# Bearer token for a server with AUTH_REQUIRED=1 (pnpm issuer token --sub <name> --scope "mcp:tools")
# MCP_TOKEN=
