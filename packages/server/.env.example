# Copy to packages/server/.env (git-ignored). Values are the defaults; a shell variable wins.
# Loaded by start:http and issuer. Not by the stdio server (Cursor sets its env).

# Ports
MCP_SERVER_PORT=4768
ISSUER_PORT=4769

# Addresses
MCP_SERVER_URL=http://localhost:4768/mcp
ISSUER_URL=http://localhost:4769

# Token issuer
ISSUER_KEY_FILE=.auth/issuer-key.json
TOKEN_AUDIENCE=http://localhost:4768/mcp
TOKEN_TTL_SECONDS=3600

# MCP server
MCP_MODE=stateful
MCP_SESSION_TTL_MS=1800000

# Every setting here is checked at startup (Stage 10.5); a bad value stops the server and names the variable.
# NODE_ENV=production also needs AUTH_REQUIRED=1, and AUTH_REQUIRED=1 needs ISSUER_URL.

# Auth (Stage 9.3): 1 = /mcp needs a Bearer token from ISSUER_URL, for audience MCP_SERVER_URL, 0 no auth
AUTH_REQUIRED=0
# AUTH_SCOPE=mcp:tools

# Origin check (Stage 10.2): comma list of browser origins allowed to call /mcp. Default: the dashboard.
# ALLOWED_ORIGINS=http://localhost:4767,http://127.0.0.1:4767

# Limits (Stage 10.3): body cap in bytes (413), and requests per minute per caller (429). 0 = no rate limit.
# MAX_BODY_BYTES=1048576
# RATE_LIMIT_PER_MINUTE=120

# Logging (Stage 12.1): text = today's lines plus a key=value tail (req, session, sub, instance); json = one object per line.
# Levels: debug, info, warn, error. The tools' argument lines ("add called with a=2, b=3") are debug, so they are off by default.
# INSTANCE_ID tells instances apart in their logs; the default is the host name. The stdio server reads the same three variables.
# LOG_FORMAT=text
# LOG_LEVEL=info
# INSTANCE_ID=server-a

# Admin listener (Stage 12.2): /healthz ("restart me?") and /readyz ("send me traffic?") on their own port.
# Off unless ADMIN_PORT is set. It must differ from MCP_SERVER_PORT. ADMIN_HOST defaults to 127.0.0.1, so only
# this machine can reach it; use 0.0.0.0 only when something outside the host must (and keep that port private).
# /readyz asks Redis (PING) when SESSION_STORE=redis; with the memory store it is always ready.
# ADMIN_PORT=4771
# ADMIN_HOST=127.0.0.1

# Code review (optional)
# REVIEW_ROOT=/absolute/path/to/project
# REVIEW_ALLOWED_ROOTS=/path/a:/path/b
# REVIEW_ALLOW_HTTP=1
# REVIEW_REQUIRE_ROOT=1
# REVIEW_CHECK_TIMEOUT_MS=120000

# Weather (optional)
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_FETCH_TIMEOUT_MS=8000
# WEATHER_RETRY_BASE_DELAY_MS=300

# Sessions (Stage 11): memory = one process as before; redis = shared across instances and restarts.
# SESSION_STORE=memory
# REDIS_URL=redis://localhost:6379

# Resumable streams (Stage 11.3): 1 = keep stream events so a dropped stream resumes with Last-Event-ID.
# Events live in Redis when SESSION_STORE=redis, otherwise in memory. Each stream is capped and expires.
# The event counter is kept 6x longer than the events, so a client that comes back too late is refused
# ("events no longer stored") instead of being told there is nothing to replay.
# RESUMABLE_STREAMS=0
# EVENT_STORE_MAX_EVENTS=500
# EVENT_STORE_TTL_MS=300000
# 1 = print one line per stream event stored or replayed (method and progress only, never content).
# EVENT_STORE_DEBUG=0
