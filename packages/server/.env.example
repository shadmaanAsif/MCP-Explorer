# Copy to packages/server/.env (git-ignored). Values are the defaults; a shell variable wins.
# Loaded by start:http and issuer. Not by the stdio server (Cursor sets its env).

# Ports
MCP_SERVER_PORT=4768
ISSUER_PORT=4769

# Addresses
MCP_SERVER_URL=http://localhost:4768/mcp
ISSUER_URL=http://localhost:4769

# Token issuer
ISSUER_KEY_FILE=.auth/issuer-key.json
TOKEN_AUDIENCE=http://localhost:4768/mcp
TOKEN_TTL_SECONDS=3600

# MCP server
MCP_MODE=stateful
MCP_SESSION_TTL_MS=1800000

# Auth (Stage 9.3): 1 = /mcp needs a Bearer token from ISSUER_URL, for audience MCP_SERVER_URL, 0 no auth
AUTH_REQUIRED=0
# AUTH_SCOPE=mcp:tools

# Code review (optional)
# REVIEW_ROOT=/absolute/path/to/project
# REVIEW_ALLOWED_ROOTS=/path/a:/path/b
# REVIEW_ALLOW_HTTP=1
# REVIEW_REQUIRE_ROOT=1
# REVIEW_CHECK_TIMEOUT_MS=120000

# Weather (optional)
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_FETCH_TIMEOUT_MS=8000
# WEATHER_RETRY_BASE_DELAY_MS=300
