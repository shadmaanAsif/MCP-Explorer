{
  "name": "mcp-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "A learning project: building an MCP server one stage at a time — a monorepo with separate server and client packages.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm start --workspace=packages/server",
    "dev": "npm run build && npm start",
    "client": "npm start --workspace=packages/client",
    "web": "npm run build --workspace=packages/web && npm start --workspace=packages/web"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.10.5"
  }
}
